# Copy this file to .env and fill it in. .env is gitignored: never commit keys.
# Used for local runs only; on Cloud Run these come from Secret Manager.

# LINE Developers console -> your channel -> Basic settings / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google: path to a JSON file (or the JSON itself). The service account key is
# used for Sheets and for Vision OCR (enable the Cloud Vision API on its project).
GOOGLE_SA_JSON=sa.json
GOOGLE_DRIVE_TOKEN_JSON=drive_token.json

# Long ID from the Sheet URL; Drive folder ID printed by `scripts.setup create-folder`
SHEET_ID=
DRIVE_FOLDER_ID=

# Comma-separated LINE user IDs. Leave empty at first: the bot replies with your ID.
ALLOWED_USER_IDS=
# OWNER_USER_ID=

TZ=Asia/Bangkok
